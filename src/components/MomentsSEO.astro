---
import { getCollection, render } from 'astro:content';

const moments = await getCollection('moments');

// Render the markdown content for each moment
const renderedMoments = await Promise.all(
  moments.map(async (m) => {
    const rendered = await render(m);
    return {
      moment: m,
      Content: rendered.Content,
    };
  })
);
---

<section id="moments" class="moments-section">
  <div class="container-custom">
    <!-- Section Header with High SEO Focus -->
    <div class="section-header">
      <div class="badge-pill">
        <span>📖 Kisah, Filosofi & Panduan Pengantin</span>
      </div>
      <h2 class="section-title">
        2 Momen Paling Bersejarah: <br />
        <span class="text-gradient">Akad Sakral & Pesta Resepsi Penuh Cinta</span>
      </h2>
      <p class="section-subtitle">
        Setiap babak dalam pernikahan memiliki jiwa dan getarannya tersendiri. Simak bagaimana Sekar Ayu Wedding mengabadikan dua puncak perayaan cinta Anda dengan narasi visual berkelas dunia.
      </p>
    </div>

    <!-- Moments Articles Stack -->
    <div class="moments-stack">
      {renderedMoments.map(({ moment, Content }, idx) => (
        <article class={`moment-card border-gradient-wrapper ${idx % 2 === 1 ? 'reverse-layout' : ''}`}>
          <!-- Visual Media Column -->
          <div class="moment-media-col">
            <div class="moment-image-frame">
              <img
                src={moment.data.featuredImage}
                alt={moment.data.imageAlt}
                loading="lazy"
                class="moment-featured-img"
              />
              <div class="moment-image-gradient"></div>
              <span class="moment-category-badge">{moment.data.category}</span>
            </div>

            <!-- SEO Keywords Cloud -->
            <div class="moment-seo-keywords">
              <span class="seo-keywords-title">Fokus Kata Kunci SEO:</span>
              <div class="keyword-tags">
                {moment.data.seoKeywords.map((kw: string) => (
                  <span class="kw-tag">#{kw}</span>
                ))}
              </div>
            </div>

            <!-- Highlights Checklist Box -->
            <div class="moment-highlights-box glass-panel">
              <h4 class="highlights-title">
                <span class="star-icon">✦</span>
                <span>Standar Dokumentasi Khusus:</span>
              </h4>
              <ul class="highlights-list">
                {moment.data.highlights.map((item: string) => (
                  <li>
                    <span class="check-mark">✓</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Editorial Narrative Copywriting Column -->
          <div class="moment-content-col">
            <header class="moment-header">
              <div class="moment-meta-line">
                <span class="meta-item">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  <span>{moment.data.readTime}</span>
                </span>
                <span class="meta-dot">•</span>
                <span class="meta-item">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                  <span>{moment.data.location}</span>
                </span>
              </div>

              <h3 class="moment-title font-serif">{moment.data.title}</h3>
              <p class="moment-subtitle">{moment.data.subtitle}</p>
            </header>

            <div class="moment-prose-body">
              <Content />
            </div>

            <footer class="moment-footer">
              <a
                href={`https://wa.me/6282132418746?text=${encodeURIComponent(
                  `Halo Sekar Ayu Wedding, saya membaca artikel tentang "${moment.data.title}" dan ingin konsultasi dokumentasi konsep serupa untuk pernikahan saya.`
                )}`}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-secondary moment-cta-btn"
              >
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
                <span>Konsultasikan Momen Ini via WA</span>
              </a>
            </footer>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .moments-section {
    padding: 6rem 0;
    position: relative;
  }

  .section-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 4rem;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 2.9rem);
    margin: 1.25rem 0 1rem;
    line-height: 1.22;
  }

  .section-subtitle {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .moments-stack {
    display: flex;
    flex-direction: column;
    gap: 4.5rem;
  }

  .moment-card {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3.5rem;
    padding: 3rem;
    border-radius: 1.75rem;
    align-items: start;
  }

  .moment-card.reverse-layout {
    grid-template-columns: 1.2fr 1fr;
  }

  .moment-card.reverse-layout .moment-media-col {
    order: 2;
  }

  .moment-card.reverse-layout .moment-content-col {
    order: 1;
  }

  /* Media Column */
  .moment-media-col {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .moment-image-frame {
    position: relative;
    border-radius: 1.25rem;
    overflow: hidden;
    height: 380px;
    box-shadow: var(--shadow-sm);
  }

  .moment-featured-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .moment-image-frame:hover .moment-featured-img {
    transform: scale(1.04);
  }

  .moment-image-gradient {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, transparent 50%, rgba(13, 8, 12, 0.75) 100%);
  }

  .moment-category-badge {
    position: absolute;
    bottom: 1.25rem;
    left: 1.25rem;
    padding: 0.35rem 0.9rem;
    border-radius: 99px;
    background: var(--gradient-brand);
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 700;
    box-shadow: 0 4px 12px rgba(255, 89, 135, 0.35);
  }

  /* SEO Keywords Tags */
  .moment-seo-keywords {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .seo-keywords-title {
    font-size: 0.775rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-soft);
    font-weight: 600;
  }

  .keyword-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .kw-tag {
    font-size: 0.775rem;
    padding: 0.25rem 0.65rem;
    border-radius: 0.5rem;
    background: var(--bg-surface-translucent);
    color: var(--primary-pink);
    border: 1px solid var(--border-color);
  }

  /* Highlights Box */
  .moment-highlights-box {
    padding: 1.5rem;
  }

  .highlights-title {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.925rem;
    font-family: 'Plus Jakarta Sans', sans-serif;
    color: var(--text-main);
    margin-bottom: 0.85rem;
  }

  .star-icon {
    color: var(--primary-pink);
  }

  .highlights-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .highlights-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  .check-mark {
    color: #25D366;
    font-weight: bold;
    flex-shrink: 0;
  }

  /* Narrative Column */
  .moment-content-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .moment-meta-line {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.825rem;
    color: var(--text-soft);
    margin-bottom: 0.75rem;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .moment-title {
    font-size: clamp(1.6rem, 2.6vw, 2.15rem);
    line-height: 1.25;
    margin-bottom: 0.6rem;
  }

  .moment-subtitle {
    font-size: 1.025rem;
    color: var(--primary-purple);
    font-weight: 500;
  }

  /* Prose Body Styling */
  .moment-prose-body :global(h2) {
    font-size: 1.35rem;
    margin: 1.5rem 0 0.75rem;
    font-family: 'Playfair Display', serif;
    color: var(--text-main);
  }

  .moment-prose-body :global(h3) {
    font-size: 1.15rem;
    margin: 1.25rem 0 0.5rem;
    font-family: 'Plus Jakarta Sans', sans-serif;
    color: var(--text-main);
  }

  .moment-prose-body :global(p) {
    font-size: 0.965rem;
    color: var(--text-muted);
    line-height: 1.75;
    margin-bottom: 1.15rem;
  }

  .moment-prose-body :global(blockquote) {
    margin: 1.5rem 0;
    padding: 1.25rem 1.75rem;
    border-left: 3px solid var(--primary-pink);
    background: var(--bg-surface-translucent);
    border-radius: 0 0.75rem 0.75rem 0;
    font-style: italic;
    color: var(--text-main);
    font-size: 0.985rem;
    line-height: 1.6;
  }

  .moment-prose-body :global(ul) {
    margin-bottom: 1.25rem;
    padding-left: 1.25rem;
    color: var(--text-muted);
  }

  .moment-prose-body :global(li) {
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
  }

  .moment-cta-btn {
    align-self: flex-start;
    padding: 0.75rem 1.5rem;
  }

  @media (max-width: 980px) {
    .moment-card,
    .moment-card.reverse-layout {
      grid-template-columns: 1fr;
      padding: 2rem 1.5rem;
      gap: 2.25rem;
    }

    .moment-card.reverse-layout .moment-media-col {
      order: 1;
    }

    .moment-card.reverse-layout .moment-content-col {
      order: 2;
    }

    .moment-image-frame {
      height: 280px;
    }
  }
</style>
